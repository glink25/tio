{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "printWidth": 100,
  "sortImports": {},
  "sortTailwindcss": {
    "stylesheet": "./packages/app/src/styles/tailwind.css",
    "functions": ["cn", "clsx"]
  },
  "ignorePatterns": [
    "**/dist/**",
    "apps/native/src-tauri/target/**",
    "apps/native/src-tauri/gen/**",
    "**/node_modules/**",
    "pnpm-lock.yaml",
    ".tmp/**",
    "docs/.local/**",
    "tests/test-results/**",
    "tests/playwright-report/**",
    "tests/.cache/**",
    "tests/tmp/**"
  ]
}
