{
  "name": "tio",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first document and database workspace with portable file synchronization.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "corepack pnpm --filter @tio/web dev",
    "build": "corepack pnpm --filter @tio/web-editor build && corepack pnpm --filter @tio/web build && node tests/scripts/check-editor-css.mjs",
    "preview": "corepack pnpm --filter @tio/web preview",
    "typecheck": "corepack pnpm -r typecheck",
    "test": "corepack pnpm --filter @tio/tests test",
    "test:e2e": "corepack pnpm --filter @tio/tests test:e2e",
    "lint": "oxlint --type-aware --deny-warnings",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "corepack pnpm pages:bundle && corepack pnpm format:check && corepack pnpm lint && corepack pnpm check:boundaries && corepack pnpm typecheck && corepack pnpm test && corepack pnpm build",
    "test:watch": "corepack pnpm --filter @tio/tests test:watch",
    "lint:fix": "oxlint --type-aware --fix",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "brand:icons": "node scripts/generate-brand-icons.mjs",
    "blog:migrate": "corepack pnpm --filter @tio/blog migrate",
    "blog:build": "corepack pnpm --filter @tio/blog build",
    "blog:preview": "corepack pnpm --filter @tio/blog preview",
    "pages:build": "corepack pnpm --filter @glink25/tio-pages build:site",
    "test:pages": "corepack pnpm --filter @tio/tests test:pages",
    "pages:bundle": "corepack pnpm --filter @glink25/tio-pages build",
    "test:pages-package": "corepack pnpm pages:bundle && node tests/scripts/check-pages-package.mjs"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/wicg-file-system-access": "^2023.10.7",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "postcss": "^8.5.31",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.0.0"
  },
  "packageManager": "pnpm@12.14.0"
}
